# The backend this build talks to (no trailing slash). It serves /api/admin.
EXPO_PUBLIC_API_URL=https://ohyoufancyfocaccia.com

# The same server run locally. `npm start` in the repository root listens on
# 3000; point EXPO_PUBLIC_API_URL at this before `expo start` to work against it.
EXPO_PUBLIC_API_URL_DEV=http://localhost:3000
