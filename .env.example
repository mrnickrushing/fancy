# Oh! You Fancy Focaccia — server configuration
# Copy to .env for local work; on Railway these are service variables.

# Postgres. Railway's Postgres plugin provides this as ${{Postgres.DATABASE_URL}}.
DATABASE_URL=

# Admin sign-in. Only read until the first successful sign-in, which stores a
# hash in the database; after that the password is changed from the admin.
ADMIN_USERNAME=amanda
ADMIN_PASSWORD=

# Email (Resend). Optional: without it orders still save and the admin still
# works, but nothing is emailed. The sender domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Oh! You Fancy Focaccia <orders@ohyoufancyfocaccia.com>
BAKERY_INBOX=ohyoufancyfocaccia@gmail.com

# Absolute origin for links in emails. Falls back to CANONICAL_HOST, then
# RAILWAY_PUBLIC_DOMAIN, then localhost.
BASE_URL=https://ohyoufancyfocaccia.com
CANONICAL_HOST=ohyoufancyfocaccia.com
